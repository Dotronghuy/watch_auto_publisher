{
  "manifest_version": 3,
  "name": "ZenWatch Zalo Tab Bridge",
  "version": "1.1.0",
  "description": "Kết nối ZenWatch Tool với tab Zalo Web đang đăng nhập sẵn.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "debugger",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chat.zalo.me/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ZenWatch Zalo Tab Bridge",
    "default_popup": "popup.html"
  }
}
