# Android Worker calls must present this value as a Bearer token.
# Generate a long random value before exposing the backend to the Internet.
MOBILE_WORKER_TOKEN=replace-with-at-least-32-random-characters

# Stable public HTTPS URL created by Tailscale Funnel.
MOBILE_WORKER_BASE_URL=https://your-windows-pc.your-tailnet.ts.net

# android_worker (recommended) or disabled.
MOBILE_SHOPEE_LINK_MODE=android_worker

# Optional label shown below the Shopee URL on Facebook.
MOBILE_SHOPEE_LINK_NAME=Mua ở đây
