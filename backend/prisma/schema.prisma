generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./app.db"
}

model Shop {
  id            String           @id @default(uuid())
  name          String
  publishMode   String           @default("GROUPED")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  shopeeAccount ShopeeAccount?
  templates     TemplateConfig[]
  users         User[]
  products      WatchModel[]
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  role        String   @default("user")
  permissions String?
  shopId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop?    @relation(fields: [shopId], references: [id])
}

model TemplateConfig {
  id           String @id @default(uuid())
  shopId       String
  nameTemplate String @default("[Mã {{sku}}] {{product_name}} chính hãng")
  descTemplate String @default("Sản phẩm {{product_name}} hiện đang có sẵn...")
  shop         Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model ShopeeAccount {
  id         String  @id @default(uuid())
  shopId     String  @unique
  cookieData String?
  shop       Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model WatchModel {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  basePrice   Float?
  shopId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  variants    Variant[]
  shop        Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Variant {
  id              String     @id @default(uuid())
  modelId         String
  color           String
  sku             String     @unique
  price           Float
  shopeeProductId String?
  rawImage        String?
  avatarImage     String?
  status          String     @default("DRAFT")
  bannerPosition  Int?
  syncTasks       SyncTask[]
  model           WatchModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model SyncTask {
  id        String   @id @default(uuid())
  variantId String
  action    String
  status    String   @default("PENDING")
  logs      String?
  createdAt DateTime @default(now())
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Setting {
  id     String  @id @default(uuid())
  key    String  @unique
  value  String
  shopId String?
}

model ZaloPostHistory {
  id        String   @id @default(uuid())
  productId String   @unique
  postedAt  DateTime @default(now())
}

model MobileLinkJob {
  id             String    @id @default(uuid())
  postId         String    @unique
  postUrl        String
  shopeeUrl      String
  linkName       String    @default("Mua ở đây")
  status         String    @default("PENDING")
  deviceId       String?
  attempt        Int       @default(0)
  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  completedAt    DateTime?
  errorMessage   String?
  resultMessage  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([deviceId, status])
}
